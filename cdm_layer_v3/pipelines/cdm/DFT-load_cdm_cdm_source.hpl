    <parameters />
    <name>DFT-load_cdm_cdm_source</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>describes this CDM in cdm.cdm_source (needed by DQD and ATLAS)</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/11/28 01:00:00.000</created_date>
    <modified_date>2026/11/28 01:00:00.000</modified_date>
    <created_hop_version />
    <modified_hop_version>2.20.0</modified_hop_version>
  </info>
  <transform>
    <type>TableInput</type>
    <name>DB_SRC-cdm_source_facts</name>
    <sql>SELECT
  (SELECT vocabulary_version FROM cdm.vocabulary WHERE vocabulary_id = 'None')
, (SELECT max(_loaded_at) FROM ods.patient)
, (SELECT coalesce(min(concept_id), 0) FROM cdm.concept
   WHERE vocabulary_id = 'CDM'
     AND (concept_name ILIKE 'OMOP CDM Version 5.4%' OR concept_code ILIKE 'CDM v5.4%'))
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN-PG_OMOP</connection>
    <lookup />
    <sql_from_file />
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>48</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>SystemInfo</type>
    <name>SYS-today</name>
    <fields>
