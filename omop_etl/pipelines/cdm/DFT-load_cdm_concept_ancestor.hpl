    <line_number_files_destination_directory />
    <line_number_files_extension>line</line_number_files_extension>
    <fields>
      <field>
        <name>ancestor_concept_id</name>
        <position>-1</position>
        <length>-1</length>
        <type>String</type>
        <ignore>N</ignore>
        <format />
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency />
        <decimal>.</decimal>
        <group>,</group>
        <repeat>N</repeat>
        <null_string />
        <if_null_value />
      </field>
      <field>
        <name>descendant_concept_id</name>
        <position>-1</position>
        <length>-1</length>
        <type>String</type>
        <ignore>N</ignore>
        <format />
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency />
        <decimal>.</decimal>
        <group>,</group>
        <repeat>N</repeat>
        <null_string />
        <if_null_value />
      </field>
      <field>
        <name>min_levels_of_separation</name>
        <position>-1</position>
        <length>-1</length>
        <type>String</type>
        <ignore>N</ignore>
        <format />
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency />
        <decimal>.</decimal>
        <group>,</group>
        <repeat>N</repeat>
        <null_string />
        <if_null_value />
      </field>
      <field>
        <name>max_levels_of_separation</name>
        <position>-1</position>
        <length>-1</length>
