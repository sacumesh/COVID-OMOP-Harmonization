    <modified_date>2026/11/28 18:00:00.000</modified_date>
    <created_hop_version />
    <modified_hop_version>2.20.0</modified_hop_version>
  </info>
  <transform>
    <type>TextFileInput2</type>
    <name>FF_SRC-concept_ancestor</name>
    <description>Reads CONCEPT_ANCESTOR.csv from ${VOCAB_DIR}: tab-separated, header line, no quotes, UTF-8, every column as text</description>
    <file_type>CSV</file_type>
    <compression>None</compression>
    <separator>	</separator>
    <enclosure />
    <enclosure_breaks>N</enclosure_breaks>
    <escapechar />
    <null_if_not_enclosed>N</null_if_not_enclosed>
    <header>Y</header>
    <prependFileName>N</prependFileName>
    <nr_headerlines>1</nr_headerlines>
    <footer>N</footer>
    <nr_footerlines>1</nr_footerlines>
    <line_wrapped>N</line_wrapped>
    <nr_wraps>1</nr_wraps>
    <layout_paged>N</layout_paged>
    <nr_lines_per_page>80</nr_lines_per_page>
    <nr_lines_doc_header>0</nr_lines_doc_header>
    <noempty>Y</noempty>
    <include>N</include>
    <include_field />
    <rownum>N</rownum>
    <rownum_field />
    <rownumByFile>N</rownumByFile>
    <format>mixed</format>
    <encoding>UTF-8</encoding>
    <limit>0</limit>
    <date_format_lenient>Y</date_format_lenient>
    <date_format_locale>en_US</date_format_locale>
    <length />
    <parallel>N</parallel>
    <chunk_size>128MB</chunk_size>
    <read_ahead_blocks>0</read_ahead_blocks>
    <filters />
    <error_count_field />
    <error_fields_field />
    <error_text_field />
    <error_line_skipped>N</error_line_skipped>
    <schema_definition />
    <ignore_fields>N</ignore_fields>
    <namingScheme />
    <shortFileFieldName />
    <extensionFieldName />
    <pathFieldName />
    <sizeFieldName />
    <hiddenFieldName />
    <lastModificationTimeFieldName />
    <uriNameFieldName />
    <rootUriNameFieldName />
    <files>
      <file>
        <name>${VOCAB_DIR}/CONCEPT_ANCESTOR.csv</name>
        <filemask />
        <exclude_filemask />
        <file_required>Y</file_required>
        <include_subfolders>N</include_subfolders>
      </file>
    </files>
    <accept_filenames>N</accept_filenames>
    <accept_transform_name />
    <passing_through_fields>N</passing_through_fields>
    <accept_field />
