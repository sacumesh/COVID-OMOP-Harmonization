    <cache_size>0</cache_size>
    <sql>SELECT source_concept_id, target_concept_id, target_domain_id, target_value_concept_id
FROM map.code_map
WHERE code_system = ? AND source_code = ?
  AND (target_concept_id = 0
       OR target_domain_id IN ('Condition', 'Observation', 'Procedure', 'Measurement'))</sql>
