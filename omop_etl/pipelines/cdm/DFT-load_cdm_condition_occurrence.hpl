    <description>Sends each row to the CDM table of its concept's domain (unmapped -&gt; condition_occurrence)</description>
    <fieldname>target_domain_id</fieldname>
    <case_value_type>String</case_value_type>
    <case_value_format />
    <case_value_decimal />
    <case_value_group />
    <cases>
      <case>
        <value>Condition</value>
        <target_transform>SEQ-condition_occurrence_id</target_transform>
      </case>
      <case>
        <value>Observation</value>
        <target_transform>SEQ-observation_id</target_transform>
      </case>
      <case>
        <value>Procedure</value>
        <target_transform>SEQ-procedure_occurrence_id</target_transform>
      </case>
      <case>
        <value>Measurement</value>
        <target_transform>SEQ-measurement_id</target_transform>
      </case>
    </cases>
    <default_target_transform>SEQ-condition_occurrence_id</default_target_transform>
