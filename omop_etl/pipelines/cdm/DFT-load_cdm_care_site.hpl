<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>DFT-load_cdm_care_site</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>ods.source_site (the hospitals) -&gt; cdm.care_site</description>
    <extended_description />
    <pipeline_version />
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_status>0</pipeline_status>
    <parameters />
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/11/28 18:00:00.000</created_date>
    <modified_date>2026/11/28 18:00:00.000</modified_date>
    <created_hop_version />
    <modified_hop_version>2.20.0</modified_hop_version>
  </info>
  <transform>
    <type>TableInput</type>
    <name>DB_SRC-ods_source_site</name>
    <description>The hospitals from the reference table, numbered in code order (hospital1 = 1, ...)</description>
    <sql>SELECT
  row_number() OVER (ORDER BY source_site) AS care_site_id
, site_name
, source_site
FROM ods.source_site
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN-PG_OMOP</connection>
    <lookup />
    <sql_from_file />
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>DCNV-cdm_care_site</name>
    <description>Renames to the cdm.care_site column names</description>
    <fields>
      <field>
        <name>care_site_id</name>
        <rename />
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>site_name</name>
        <rename>care_site_name</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>source_site</name>
        <rename>care_site_source_value</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>288</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>DB_DST-cdm_care_site</name>
    <description>Inserts into cdm.care_site (WF-load_cdm empties it before the run)</description>
    <connection>CONN-PG_OMOP</connection>
    <schema>cdm</schema>
    <table>care_site</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field />
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field />
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field />
    <fields>
      <field>
        <column_name>care_site_id</column_name>
        <stream_name>care_site_id</stream_name>
      </field>
      <field>
        <column_name>care_site_name</column_name>
        <stream_name>care_site_name</stream_name>
      </field>
      <field>
        <column_name>care_site_source_value</column_name>
        <stream_name>care_site_source_value</stream_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>Constant</type>
    <name>CST-reject_write</name>
    <description>Rejected rows of DB_DST-cdm_care_site: adds which pipeline and which step refused them</description>
    <fields>
      <field>
        <currency />
        <decimal />
        <group />
        <nullif>DFT-load_cdm_care_site</nullif>
        <name>pipeline_name</name>
        <type>String</type>
        <format />
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency />
        <decimal />
        <group />
        <nullif>DB_DST-cdm_care_site</nullif>
        <name>transform_name</name>
        <type>String</type>
        <format />
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>DB_DST-adm_cdm_load_reject</name>
    <description>Writes the rejected rows of DB_DST-cdm_care_site with the error Hop reported</description>
    <connection>CONN-PG_OMOP</connection>
    <schema>adm</schema>
    <table>cdm_load_reject</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field />
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field />
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field />
    <fields>
      <field>
        <column_name>pipeline_name</column_name>
        <stream_name>pipeline_name</stream_name>
      </field>
      <field>
        <column_name>transform_name</column_name>
        <stream_name>transform_name</stream_name>
      </field>
      <field>
        <column_name>source_site</column_name>
        <stream_name>care_site_source_value</stream_name>
      </field>
      <field>
        <column_name>error_count</column_name>
        <stream_name>error_count</stream_name>
      </field>
      <field>
        <column_name>error_fields</column_name>
        <stream_name>error_fields</stream_name>
      </field>
      <field>
        <column_name>error_codes</column_name>
        <stream_name>error_codes</stream_name>
      </field>
      <field>
        <column_name>error_description</column_name>
        <stream_name>error_description</stream_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>608</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <order>
    <hop>
      <from>DB_SRC-ods_source_site</from>
      <to>DCNV-cdm_care_site</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DCNV-cdm_care_site</from>
      <to>DB_DST-cdm_care_site</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DB_DST-cdm_care_site</from>
      <to>CST-reject_write</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>CST-reject_write</from>
      <to>DB_DST-adm_cdm_load_reject</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>DFT-load_cdm_care_site
ods.source_site (data/reference/source_site.csv) -&gt; cdm.care_site, one row per hospital.
care_site_source_value = the hospital code, so person and visit_occurrence can find their care site.
Refused rows go to adm.cdm_load_reject.</note>
      <xloc>32</xloc>
      <yloc>16</yloc>
      <width>724</width>
      <heigth>92</heigth>
      <fontname />
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <attributes />
  <transform_error_handling>
    <error>
      <source_transform>DB_DST-cdm_care_site</source_transform>
      <target_transform>CST-reject_write</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>error_count</nr_valuename>
      <descriptions_valuename>error_description</descriptions_valuename>
      <fields_valuename>error_fields</fields_valuename>
      <codes_valuename>error_codes</codes_valuename>
      <max_errors />
      <max_pct_errors />
      <min_pct_rows />
    </error>
  </transform_error_handling>
</pipeline>