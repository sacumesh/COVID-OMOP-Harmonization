        <stream_name>error_description</stream_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>608</xloc>
      <yloc>624</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <order>
    <hop>
      <from>FF_SRC-cdm_source</from>
      <to>LKP-cdm_source_facts</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>LKP-cdm_source_facts</from>
      <to>SYS-today</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>SYS-today</from>
      <to>DCNV-cdm_source</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DCNV-cdm_source</from>
      <to>DB_DST-cdm_cdm_source</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DB_DST-cdm_cdm_source</from>
      <to>CST-reject_write</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>CST-reject_write</from>
      <to>DB_DST-adm_cdm_load_reject</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>DFT-load_cdm_cdm_source
${REFERENCE_DIR}/cdm_source.csv (name, holder, description: edit it there) + facts from the database
-&gt; cdm.cdm_source, the one-row description of this CDM that DQD and ATLAS read.
Refused rows go to adm.cdm_load_reject.</note>
      <xloc>32</xloc>
      <yloc>16</yloc>
      <width>724</width>
      <heigth>92</heigth>
      <fontname />
      <fontsize>-1</fontsize>
