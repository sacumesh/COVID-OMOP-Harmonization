        <stream_name>cdm_version_concept_id</stream_name>
      </field>
      <field>
        <column_name>vocabulary_version</column_name>
        <stream_name>vocabulary_version</stream_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>624</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>Constant</type>
    <name>CST-reject_write</name>
    <description>Rejected rows of DB_DST-cdm_cdm_source: adds which pipeline and which step refused them</description>
    <fields>
      <field>
        <currency />
        <decimal />
        <group />
        <nullif>DFT-load_cdm_cdm_source</nullif>
