    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>LKP-cdm_source_facts</name>
    <description>Facts read from the database: vocabulary version, date of the source data, CDM version concept</description>
    <connection>CONN-PG_OMOP</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <sql>SELECT
  (SELECT vocabulary_version FROM cdm.vocabulary WHERE vocabulary_id = 'None') AS vocabulary_version
, (SELECT max(_loaded_at) FROM ods.patient) AS source_release_date
, (SELECT coalesce(min(concept_id), 0) FROM cdm.concept
   WHERE vocabulary_id = 'CDM'
     AND (concept_name ILIKE 'OMOP CDM Version 5.4%' OR concept_code ILIKE 'CDM v5.4%')) AS cdm_version_concept_id
</sql>
    <sql_from_file />
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>288</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>SystemInfo</type>
    <name>SYS-today</name>
    <description>Today = CDM release date</description>
    <fields>
      <field>
        <name>cdm_release_date</name>
        <type>system date (variable)</type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>DCNV-cdm_source</name>
    <description>Sets the date and id types</description>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>source_release_date</name>
        <rename />
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type />
        <conversion_mask>yyyy-MM-dd</conversion_mask>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale />
        <date_format_timezone />
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol />
        <grouping_symbol />
        <currency_symbol />
        <encoding />
        <roundingType>half_even</roundingType>
      </meta>
      <meta>
        <name>cdm_release_date</name>
        <rename />
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type />
        <conversion_mask>yyyy-MM-dd</conversion_mask>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale />
        <date_format_timezone />
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol />
        <grouping_symbol />
        <currency_symbol />
        <encoding />
        <roundingType>half_even</roundingType>
      </meta>
      <meta>
        <name>cdm_version_concept_id</name>
        <rename />
        <type>Integer</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type />
        <conversion_mask />
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale />
        <date_format_timezone />
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol />
        <grouping_symbol />
        <currency_symbol />
        <encoding />
        <roundingType>half_even</roundingType>
      </meta>
    </fields>
