  <transform>
    <type>TableInput</type>
    <name>DB_SRC-ods_patient</name>
    <description>Every patient of every hospital</description>
    <sql>SELECT
  source_site
, patient_number
, sex_code
, sex_code_system
, birth_date
, birth_time
, _src_filename
, _src_rownum
FROM ods.patient
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN-PG_OMOP</connection>
