<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>DFT-load_cdm_visit_occurrence</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>map.visit_source (episodes, dates derived from their events) -&gt; cdm.visit_occurrence</description>
    <extended_description />
    <pipeline_version />
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_status>0</pipeline_status>
    <parameters />
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/11/28 18:00:00.000</created_date>
    <modified_date>2026/11/28 18:00:00.000</modified_date>
    <created_hop_version />
    <modified_hop_version>2.20.0</modified_hop_version>
  </info>
  <transform>
    <type>TableInput</type>
    <name>DB_SRC-map_visit_source</name>
    <description>Every episode with its first and last event date</description>
    <sql>SELECT
  visit_occurrence_id
, source_site
, patient_number
, episode_number
, visit_start_date
, visit_end_date
FROM map.visit_source
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN-PG_OMOP</connection>
    <lookup />
    <sql_from_file />
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>LKP-person_id</name>
    <description>person_id of the patient, from map.person_map</description>
    <connection>CONN-PG_OMOP</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema>map</schema>
      <table>person_map</table>
      <key>
        <name>source_site</name>
        <field>source_site</field>
        <condition>=</condition>
        <name2 />
      </key>
      <key>
        <name>patient_number</name>
        <field>patient_number</field>
        <condition>=</condition>
        <name2 />
      </key>
      <value>
        <name>person_id</name>
        <rename>person_id</rename>
        <default />
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <orderby />
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>288</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>LKP-care_site_id</name>
    <description>care_site_id of the hospital</description>
    <connection>CONN-PG_OMOP</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema>cdm</schema>
      <table>care_site</table>
      <key>
        <name>source_site</name>
        <field>care_site_source_value</field>
        <condition>=</condition>
        <name2 />
      </key>
      <value>
        <name>care_site_id</name>
        <rename>care_site_id</rename>
        <default />
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <orderby />
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>Constant</type>
    <name>CST-visit</name>
    <description>Visit type not in the source -&gt; 0; dates derived by rule -&gt; 32882 Standard algorithm from EHR</description>
    <fields>
      <field>
        <currency />
        <decimal />
        <group />
        <nullif>0</nullif>
        <name>visit_concept_id</name>
        <type>Integer</type>
        <format />
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency />
        <decimal />
        <group />
        <nullif>32882</nullif>
        <name>visit_type_concept_id</name>
        <type>Integer</type>
        <format />
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
