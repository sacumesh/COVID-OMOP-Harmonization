<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_status>-1</pipeline_status>
    <parameters />
    <name>DFT-load_map_visit_map</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>episode numbers of all ODS event tables -&gt; map.visit_map: new episodes get the next id</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/11/28 01:00:00.000</created_date>
    <modified_date>2026/11/28 01:00:00.000</modified_date>
    <created_hop_version />
    <modified_hop_version>2.20.0</modified_hop_version>
  </info>
  <transform>
    <type>TableInput</type>
    <name>DB_SRC-ods_episodes</name>
    <sql>SELECT source_site, patient_number, episode_number FROM ods.diagnosis WHERE episode_number IS NOT NULL
UNION SELECT source_site, patient_number, episode_number FROM ods.drug WHERE episode_number IS NOT NULL
UNION SELECT source_site, patient_number, episode_number FROM ods.lab_result WHERE episode_number IS NOT NULL
UNION SELECT source_site, patient_number, episode_number FROM ods.vitals WHERE episode_number IS NOT NULL
ORDER BY source_site, patient_number, episode_number
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN-PG_OMOP</connection>
    <lookup />
    <sql_from_file />
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>48</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>UPS-map_visit_map</name>
    <lookup>
      <key>
        <name>source_site</name>
        <field>source_site</field>
        <condition>=</condition>
        <name2 />
      </key>
      <key>
        <name>patient_number</name>
        <field>patient_number</field>
        <condition>=</condition>
        <name2 />
      </key>
      <key>
        <name>episode_number</name>
        <field>episode_number</field>
        <condition>=</condition>
        <name2 />
      </key>
      <value>
        <name>source_site</name>
        <rename>source_site</rename>
        <update>N</update>
      </value>
      <value>
        <name>patient_number</name>
        <rename>patient_number</rename>
        <update>N</update>
      </value>
      <value>
        <name>episode_number</name>
        <rename>episode_number</rename>
        <update>N</update>
      </value>
      <schema>map</schema>
      <table>visit_map</table>
    </lookup>
    <commit>1000</commit>
    <update_bypassed>Y</update_bypassed>
    <connection>CONN-PG_OMOP</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <order>
    <hop>
      <from>DB_SRC-ods_episodes</from>
      <to>UPS-map_visit_map</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads />
  <attributes />
  <transform_error_handling />
</pipeline>