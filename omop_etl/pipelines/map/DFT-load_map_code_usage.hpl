    <created_hop_version />
    <modified_hop_version>2.20.0</modified_hop_version>
  </info>
  <transform>
    <type>TableInput</type>
    <name>DB_SRC-ods_codes_used</name>
    <description>Every code used in ODS, per coded column, with how many records and persons use it</description>
    <sql>SELECT
  'diagnosis.diagnosis_code' AS ods_column
, diagnosis_code_system
, diagnosis_code
, max(diagnosis_text) AS source_name
, count(*) AS record_count
, count(DISTINCT (source_site, patient_number)) AS person_count
FROM ods.diagnosis
GROUP BY diagnosis_code_system, diagnosis_code
UNION ALL
SELECT 'diagnosis.diagnosis_type_code', diagnosis_type_code_system, diagnosis_type_code, NULL, count(*),
       count(DISTINCT (source_site, patient_number))
FROM ods.diagnosis WHERE diagnosis_type_code IS NOT NULL
GROUP BY diagnosis_type_code_system, diagnosis_type_code
UNION ALL
SELECT 'drug.drug_code', drug_code_system, drug_code, max(drug_text), count(*),
       count(DISTINCT (source_site, patient_number))
FROM ods.drug
GROUP BY drug_code_system, drug_code
UNION ALL
SELECT 'drug.route_code', route_code_system, route_code, NULL, count(*),
       count(DISTINCT (source_site, patient_number))
FROM ods.drug WHERE route_code IS NOT NULL
GROUP BY route_code_system, route_code
UNION ALL
SELECT 'lab_result.test_code', test_code_system, test_code, max(test_text), count(*),
       count(DISTINCT (source_site, patient_number))
FROM ods.lab_result
GROUP BY test_code_system, test_code
UNION ALL
SELECT 'lab_result.unit_code', unit_code_system, unit_code, NULL, count(*),
       count(DISTINCT (source_site, patient_number))
FROM ods.lab_result WHERE unit_code IS NOT NULL
GROUP BY unit_code_system, unit_code
UNION ALL
SELECT 'patient.sex_code', sex_code_system, sex_code, NULL, count(*),
       count(DISTINCT (source_site, patient_number))
FROM ods.patient WHERE sex_code IS NOT NULL
GROUP BY sex_code_system, sex_code
UNION ALL
SELECT 'vitals.vital_code', vital_code_system, vital_code, NULL, count(*),
       count(DISTINCT (source_site, patient_number))
FROM ods.vitals
GROUP BY vital_code_system, vital_code
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN-PG_OMOP</connection>
    <lookup />
    <sql_from_file />
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
