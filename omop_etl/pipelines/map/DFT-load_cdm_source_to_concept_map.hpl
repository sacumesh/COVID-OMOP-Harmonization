        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency />
        <decimal />
        <group />
        <nullif>UCUM</nullif>
        <name>target_vocabulary_id</name>
        <type>String</type>
        <format />
