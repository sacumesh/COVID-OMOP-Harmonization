        <decimal_symbol />
        <grouping_symbol />
        <currency_symbol />
        <encoding />
        <roundingType>half_even</roundingType>
      </meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
