<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>DFT-load_cdm_source_to_concept_map</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>map.unit_rule (tier 1 and 2) -&gt; cdm.source_to_concept_map, for every hospital unit code system</description>
    <extended_description />
    <pipeline_version />
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_status>0</pipeline_status>
    <parameters />
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/11/28 18:00:00.000</created_date>
    <modified_date>2026/11/28 18:00:00.000</modified_date>
    <created_hop_version />
    <modified_hop_version>2.20.0</modified_hop_version>
  </info>
  <transform>
    <type>TableInput</type>
    <name>DB_SRC-unit_rules_with_concept</name>
    <description>Unit rules that identify a unit (tier 1 and 2) with their UCUM concept, once per unit code system (H1_UNIT, H2_UNIT, H3_UNIT, from ods.source_code_system)</description>
    <sql>SELECT DISTINCT
  map.unit_rule.unit_as_sent
, ods.source_code_system.code_system
, map.unit_rule.rule
, cdm.concept.concept_id
FROM map.unit_rule
JOIN cdm.concept
  ON  cdm.concept.vocabulary_id = 'UCUM'
  AND cdm.concept.concept_code = map.unit_rule.ucum_code
  AND cdm.concept.domain_id = 'Unit'
  AND cdm.concept.standard_concept = 'S'
  AND cdm.concept.invalid_reason IS NULL
JOIN ods.source_code_system
  ON  ods.source_code_system.ods_column = 'lab_result.unit_code'
WHERE map.unit_rule.tier IN (1, 2)
ORDER BY 2, 1
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN-PG_OMOP</connection>
    <lookup />
    <sql_from_file />
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>Constant</type>
    <name>CST-source_to_concept_map</name>
    <description>Fixed values of a source_to_concept_map row: no source concept, valid without end</description>
    <fields>
      <field>
        <currency />
        <decimal />
        <group />
        <nullif>0</nullif>
        <name>source_concept_id</name>
        <type>Integer</type>
        <format />
