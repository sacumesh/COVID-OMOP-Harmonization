<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>DFT-load_map_lab_ambiguous_code</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>lab results whose test code appears more than once in one order -&gt; map.lab_ambiguous_code</description>
    <extended_description />
    <pipeline_version />
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_status>0</pipeline_status>
    <parameters />
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/11/28 18:00:00.000</created_date>
    <modified_date>2026/11/28 18:00:00.000</modified_date>
    <created_hop_version />
    <modified_hop_version>2.20.0</modified_hop_version>
  </info>
  <transform>
    <type>TableInput</type>
    <name>DB_SRC-ods_lab_repeated_codes</name>
    <description>The same test code more than once in one order (hospital 2: e.g. aPTT in seconds and as a ratio)</description>
    <sql>SELECT
  source_site
, order_number
, test_code
, count(*) AS result_count
FROM ods.lab_result
GROUP BY source_site, order_number, test_code
HAVING count(*) &gt; 1
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN-PG_OMOP</connection>
    <lookup />
    <sql_from_file />
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>DCNV-lab_ambiguous_code</name>
    <description>result_count as an Integer</description>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>result_count</name>
        <rename />
        <type>Integer</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type />
        <conversion_mask />
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale />
        <date_format_timezone />
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol />
        <grouping_symbol />
        <currency_symbol />
        <encoding />
        <roundingType>half_even</roundingType>
      </meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>288</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>DB_DST-map_lab_ambiguous_code</name>
    <description>Inserts into map.lab_ambiguous_code (accepted_domain gets its default: none)</description>
    <connection>CONN-PG_OMOP</connection>
    <schema>map</schema>
    <table>lab_ambiguous_code</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field />
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field />
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field />
    <fields>
      <field>
        <column_name>source_site</column_name>
        <stream_name>source_site</stream_name>
      </field>
      <field>
        <column_name>order_number</column_name>
        <stream_name>order_number</stream_name>
      </field>
      <field>
        <column_name>test_code</column_name>
        <stream_name>test_code</stream_name>
      </field>
      <field>
        <column_name>result_count</column_name>
        <stream_name>result_count</stream_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>Constant</type>
    <name>CST-reject_write</name>
    <description>Rejected rows of DB_DST-map_lab_ambiguous_code: adds which pipeline and which step refused them</description>
    <fields>
      <field>
        <currency />
        <decimal />
        <group />
        <nullif>DFT-load_map_lab_ambiguous_code</nullif>
        <name>pipeline_name</name>
        <type>String</type>
        <format />
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency />
        <decimal />
        <group />
        <nullif>DB_DST-map_lab_ambiguous_code</nullif>
        <name>transform_name</name>
        <type>String</type>
        <format />
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>DB_DST-adm_map_load_reject</name>
    <description>Writes the rejected rows of DB_DST-map_lab_ambiguous_code with the error Hop reported</description>
    <connection>CONN-PG_OMOP</connection>
    <schema>adm</schema>
    <table>map_load_reject</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field />
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field />
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field />
    <fields>
      <field>
        <column_name>pipeline_name</column_name>
        <stream_name>pipeline_name</stream_name>
      </field>
      <field>
        <column_name>transform_name</column_name>
        <stream_name>transform_name</stream_name>
      </field>
      <field>
        <column_name>source_site</column_name>
        <stream_name>source_site</stream_name>
      </field>
      <field>
        <column_name>error_count</column_name>
        <stream_name>error_count</stream_name>
      </field>
      <field>
        <column_name>error_fields</column_name>
        <stream_name>error_fields</stream_name>
      </field>
      <field>
        <column_name>error_codes</column_name>
        <stream_name>error_codes</stream_name>
      </field>
      <field>
        <column_name>error_description</column_name>
        <stream_name>error_description</stream_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>608</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <order>
    <hop>
      <from>DB_SRC-ods_lab_repeated_codes</from>
      <to>DCNV-lab_ambiguous_code</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DCNV-lab_ambiguous_code</from>
      <to>DB_DST-map_lab_ambiguous_code</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DB_DST-map_lab_ambiguous_code</from>
      <to>CST-reject_write</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>CST-reject_write</from>
      <to>DB_DST-adm_map_load_reject</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>DFT-load_map_lab_ambiguous_code
A test code that appears more than once in one order cannot tell which result it is.
Those results get measurement_concept_id 0 in DFT-load_cdm_measurement_lab (code kept in the source value).
Refused rows go to adm.map_load_reject.</note>
      <xloc>32</xloc>
      <yloc>16</yloc>
      <width>773</width>
      <heigth>92</heigth>
      <fontname />
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <attributes />
  <transform_error_handling>
    <error>
      <source_transform>DB_DST-map_lab_ambiguous_code</source_transform>
      <target_transform>CST-reject_write</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>error_count</nr_valuename>
      <descriptions_valuename>error_description</descriptions_valuename>
      <fields_valuename>error_fields</fields_valuename>
      <codes_valuename>error_codes</codes_valuename>
      <max_errors />
      <max_pct_errors />
      <min_pct_rows />
    </error>
  </transform_error_handling>
</pipeline>