<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>DFT-load_map_code_map</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>map.code_usage + OMOP vocabulary + source_to_concept_map -&gt; map.code_map</description>
    <extended_description />
    <pipeline_version />
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_status>0</pipeline_status>
    <parameters />
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/11/28 18:00:00.000</created_date>
    <modified_date>2026/11/28 18:00:00.000</modified_date>
    <created_hop_version />
    <modified_hop_version>2.20.0</modified_hop_version>
  </info>
  <transform>
    <type>TableInput</type>
    <name>DB_SRC-code_mapping</name>
    <description>Maps every used code: vocabulary 'Maps to', else reviewed source_to_concept_map, else concept 0</description>
    <sql>WITH codes AS (
  SELECT DISTINCT code_system, source_code FROM map.code_usage
),
-- 1. codes of standard vocabularies: the code's own concept, then its valid 'Maps to' standard concept(s)
vocabulary_map (code_system, source_code, source_concept_id, target_concept_id, target_domain_id,
                target_value_concept_id, mapping_source, unmapped_reason) AS (
  SELECT DISTINCT codes.code_system, codes.source_code,
         coalesce(src.concept_id, 0),
         coalesce(tgt.concept_id, 0),
         tgt.domain_id,
         val.concept_id_2,
         CASE WHEN tgt.concept_id IS NULL THEN 'unmapped' ELSE 'vocabulary' END,
         CASE WHEN src.concept_id IS NULL THEN 'code not found in ' || v.vocabulary_id
              WHEN tgt.concept_id IS NULL THEN 'no valid Maps to standard concept' END
  FROM codes
  JOIN map.code_system_vocabulary v
    ON v.code_system = codes.code_system AND v.vocabulary_id IS NOT NULL
  LEFT JOIN cdm.concept src
    ON src.vocabulary_id = v.vocabulary_id AND src.concept_code = codes.source_code
  LEFT JOIN cdm.concept_relationship cr
    ON cr.concept_id_1 = src.concept_id AND cr.relationship_id = 'Maps to' AND cr.invalid_reason IS NULL
  LEFT JOIN cdm.concept tgt
    ON tgt.concept_id = cr.concept_id_2 AND tgt.standard_concept = 'S' AND tgt.invalid_reason IS NULL
  LEFT JOIN cdm.concept_relationship val
    ON val.concept_id_1 = src.concept_id AND val.relationship_id = 'Maps to value' AND val.invalid_reason IS NULL
   AND tgt.domain_id IN ('Observation', 'Measurement')
),
-- 2. reviewed mappings in cdm.source_to_concept_map (source_vocabulary_id = the ODS code system, e.g. H1_UNIT):
--    for local codes, and for standard codes the vocabulary could not map
stcm_map (code_system, source_code, source_concept_id, target_concept_id, target_domain_id,
          target_value_concept_id, mapping_source, unmapped_reason) AS (
  SELECT codes.code_system, codes.source_code,
         coalesce((SELECT max(vm.source_concept_id) FROM vocabulary_map vm
                   WHERE vm.code_system = codes.code_system AND vm.source_code = codes.source_code),
                  stcm.source_concept_id, 0),
         tgt.concept_id, tgt.domain_id, NULL::integer, 'source_to_concept_map', NULL::varchar
  FROM codes
  JOIN map.code_system_vocabulary v
    ON v.code_system = codes.code_system
  JOIN cdm.source_to_concept_map stcm
    ON stcm.source_vocabulary_id = codes.code_system AND stcm.source_code = codes.source_code
   AND stcm.invalid_reason IS NULL AND current_date BETWEEN stcm.valid_start_date AND stcm.valid_end_date
  JOIN cdm.concept tgt
    ON tgt.concept_id = stcm.target_concept_id AND tgt.standard_concept = 'S' AND tgt.invalid_reason IS NULL
  WHERE v.vocabulary_id IS NULL
     OR NOT EXISTS (SELECT 1 FROM vocabulary_map vm
                    WHERE vm.code_system = codes.code_system AND vm.source_code = codes.source_code
                      AND vm.target_concept_id &lt;&gt; 0)
),
mapped AS (
  SELECT * FROM vocabulary_map
  UNION ALL
  SELECT * FROM stcm_map
)
-- 3. a code with a real target keeps only its real targets (its rows with target 0 are dropped)
SELECT * FROM mapped
WHERE target_concept_id &lt;&gt; 0
   OR NOT EXISTS (SELECT 1 FROM mapped real_target
                  WHERE real_target.code_system = mapped.code_system AND real_target.source_code = mapped.source_code
                    AND real_target.target_concept_id &lt;&gt; 0)
UNION ALL
-- 4. local codes without a reviewed mapping: concept 0, listed in map.unmapped_codes
SELECT codes.code_system, codes.source_code, 0, 0, NULL, NULL, 'unmapped', 'local code, not in source_to_concept_map'
FROM codes
JOIN map.code_system_vocabulary v
  ON v.code_system = codes.code_system AND v.vocabulary_id IS NULL
WHERE NOT EXISTS (SELECT 1 FROM mapped WHERE mapped.code_system = codes.code_system AND mapped.source_code = codes.source_code)
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN-PG_OMOP</connection>
    <lookup />
    <sql_from_file />
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
