# ==========================================
# Python & uv
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ==========================================
# Apache Hop
# ==========================================
# Hop local audit logs, caches, and runtime state
hop/audit/
.hop/
*.backup
*.log
# Environment config files often contain local paths or credentials
*env*.json
hop/config/environments/

# ==========================================
# Data & Local Databases (CRITICAL for Healthcare/OMOP)
# ==========================================
# Ignore raw data, exports, and local DB files to prevent leaking sensitive patient data
data/*
!data/.gitkeep
ingestion/data/
*.csv
*.tsv
*.parquet
*.xlsx
*.xls
*.db
*.sqlite
*.sqlite3
*.dump
*.bak

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# IDEs & OS Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
